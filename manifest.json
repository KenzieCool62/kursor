{
  "manifest_version": 3,
  "name": "Kursor",
  "version": "1.0",
  "description": "Control your Kursor with a Keyboard.",
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_end"
    }
  ]
}
